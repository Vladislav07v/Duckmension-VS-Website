@* Home page view - Main landing page showcasing Duckmension VS game information
    Displays game information, features, gameplay modes, and calls to action for registration *@
@*/
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
*@
<!doctype html>
<html lang="en" data-bs-theme="auto">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="" />
    <meta name="generator" content="Astro v5.13.2" />
    <title>Heroes · Bootstrap v5.3</title>
    <link rel="canonical"
          href="https://getbootstrap.com/docs/5.3/examples/heroes/" />
    <script src="../assets/js/color-modes.js"></script>
    <link href="../assets/dist/css/bootstrap.min.css" rel="stylesheet" />
    <meta name="theme-color" content="#712cf9" />
    <link href="heroes.css" rel="stylesheet" />

</head>
<body>
    @* Hero section with game introduction and mascot duck image *@
    <div class="container col-xxl-8 px-4 py-5">
        <div class="row flex-lg-row-reverse align-items-center g-5 py-5">
            <div class="col-10 col-sm-8 col-lg-6">
                <img src="~/duck.svg"
                     class="d-block mx-lg-auto img-fluid"
                     alt="Kukki"
                     width="480"
                     height="854"
                     loading="lazy" />
            </div>
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold text-body-emphasis lh-1 mb-3">What is it?</h1>
                <p class="lead">
                    Duckmension Versus is a multiplatform, multiplayer platformer
                    game where ducks race to get the most cookies in a given
                    ammount of time. There are two gamemodes for you to compete in:
                </p>
            </div>
        </div>
    </div>
    <div class="b-example-divider"></div>

    @* Full Run game mode section with carousel of screenshots *@
    <div class="container my-5">
        <div class="row p-3 pb-0 pe-lg-0 pt-lg-0 align-items-center rounded-3 border shadow-lg">
            <div class="col-lg-6 p-3 p-lg-5 pt-lg-3">
                <h1 class="display-4 fw-bold lh-1 text-body-emphasis">
                    Full Run
                </h1>
                <p class="lead">
                    In full run, players need to go through all 50 levels.
                    The game doesn't stop until one person completes the
                    50th level. Failing makes you go back one level so
                    try not to fail several time in a row!
                </p>
            </div>
            <div class="col-lg-5 offset-lg-1 d-flex align-items-center justify-content-center p-2 shadow-lg rounded-lg-3">
                @* Carousel of Full Run gameplay screenshots *@
                <div id="carouselTimed" class="carousel slide">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/screenshot3.png" class="d-block w-100" alt="Timed Run">
                        </div>
                        <div class="carousel-item">
                            <img src="~/screenshot4.png" class="d-block w-100" alt="Timed Run">
                        </div>
                        <div class="carousel-item">
                            <img src="~/screenshot5.png" class="d-block w-100" alt="Timed Run"> 
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselTimed" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselTimed" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="b-example-divider"></div>

    @* Timed Run game mode section with carousel of screenshots *@
    <div class="container my-5">
        <div class="row p-0 pb-0 pe-lg-0 pt-lg-0 align-items-center rounded-3 border shadow-lg">
            <div class="col-lg-5 offset-lg-0 d-flex align-items-center justify-content-center p-2 shadow-lg rounded-lg-3">
                @* Carousel of Timed Run gameplay screenshots *@
                <div id="carouselFull" class="carousel slide">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/screenshot1.png" class="d-block w-100" alt="Full Run">
                        </div>
                        <div class="carousel-item">
                            <img src="~/screenshot2.png" class="d-block w-100" alt="Full Run">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselFull" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselFull" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
            <div class="col-lg-7 p-3 p-lg-5 pt-lg-3">
                <h1 class="display-4 fw-bold lh-1 text-body-emphasis">
                    Timed Run
                </h1>
                <p class="lead">
                    In timed run, players only need to complete as many levels
                    as they can for two minutes. If you go really far but
                    repeatedly fail, there is no need to worry! You will keep
                    your first spot as long as someone doesn't go past that level.
                </p>
            </div>
        </div>
    </div>
    <main>
        @* Multi-platform support section *@
        <div class="px-4 pt-5 my-5 text-center border-bottom">
            <h1 class="display-4 fw-bold text-body-emphasis">
                Play anywhere on anything you own!
            </h1>
            <div class="col-lg-6 mx-auto">
                <p class="lead mb-4">
                    Duckmension VS is built using LÖVE, this allows for easy ports
                    on many platforms. For now it can be played only on PC and 3DS
                    but in the near future you will be able to connect through
                    your phone, WiiU, Switch, PSVita and many more!
                </p>
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mb-5">
                    <button type="button" class="btn btn-primary btn-lg px-4 me-sm-3">
                        Try them out!
                    </button>
                </div>
            </div>
            <div class="overflow-hidden" style="max-height: 30vh">
                <div class="container px-5">
                    <img src="bootstrap-docs.png"
                         class="img-fluid border rounded-3 shadow-lg mb-4"
                         alt="Example image"
                         width="700"
                         height="500"
                         loading="lazy" />
                </div>
            </div>
        </div>

        <div class="b-example-divider"></div>

        @* Registration call-to-action section *@
        <div class="container col-xl-10 col-xxl-8 px-4 py-5">
            <div class="row align-items-center g-lg-5 py-5">
                <div class="col-lg-7 text-center text-lg-start">
                    <h1 class="display-4 fw-bold lh-1 text-body-emphasis mb-3">
                        Register now!
                    </h1>
                    <p class="col-lg-10 fs-4">
                        It's free and you don't have anything to loose (probably).
                        After registering, just download the game on your platform
                        of choice, log into your account and play!
                    </p>
                </div>
                <div class="col-md-10 mx-auto col-lg-5">
                    @* Show login/register buttons or message based on authentication status *@
                    <form asp-area="Identity" asp-page="/Account/Register" method="post" class="p-4 p-md-5 border rounded-3 bg-body-tertiary" id="homeRegisterForm">
                        @if (!(User.Identity?.IsAuthenticated ?? false))
                         {
                            <a class="btn btn-primary btn-lg px-2 me-md-2" asp-area="Identity" asp-page="/Account/Login">LOGIN</a>
                            <a class="btn btn-primary btn-lg px-2 me-md-2" asp-area="Identity" asp-page="/Account/Register">REGISTER</a>
                         }
                        else
                        {
                            <a class="btn btn-primary btn-lg px-2 me-md-2" asp-area="Identity">YOU DON'T NEED IT</a>
                        }
                        <hr class="my-4" />
                        <small class="text-body-secondary">By clicking Register, you agree to the terms of use.</small>
                    </form>
                </div>
            </div>
        </div>

        <div class="b-example-divider"></div>

        @* Open source section with links to GitHub repository *@
        <div class="bg-dark text-secondary px-4 py-5 text-center">
            <div class="py-5">
                <h1 class="display-5 fw-bold text-white">Do you want to take a look inside?</h1>
                <div class="col-lg-6 mx-auto">
                    <p class="fs-5 mb-4">
                        DuckmensionVS is open source and fairly easy to port to other
                        platforms! The github repository includes all code, instructions on
                        how to compile the game and some extra assets. All you need is an
                        IDE LOVE 12.0 and an engine compatible with your desired platform.
                    </p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        @* Links to GitHub repository and pull requests page *@
                        <a href="https://github.com/Vladislav07v/Duckmension-VS"
                           class="btn btn-outline-info btn-lg px-4 me-sm-3 fw-bold">Main repository</a>
                        <h2>or </h2>
                        <a href="https://github.com/Vladislav07v/Duckmension-VS/pulls"
                           class="btn btn-outline-light btn-lg px-4">Make a pull request</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="b-example-divider mb-0"></div>
    </main>
    <script src="../assets/dist/js/bootstrap.bundle.min.js"
            class="astro-vvvwv3sm"></script>
</body>
</html>
