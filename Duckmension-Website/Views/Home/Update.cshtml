@{
    Layout = "_Layout";
}

<div class="b-example-divider"></div>

<div class="container my-5">
    <div class="row p-3 pb-0 pe-lg-0 pt-lg-0 align-items-center rounded-3 border shadow-lg">
        <div class="col-lg-6 p-3 p-lg-5 pt-lg-3">
            <h1 class="display-4 fw-bold lh-1 text-body-emphasis">
                1.0!
            </h1>
            <p class="lead">
                Stay tuned for 1.0!
            </p>
        </div>
        <div class="col-lg-5 offset-lg-1 d-flex align-items-center justify-content-center p-2 shadow-lg rounded-lg-3">
            <div id="carouselTimed" class="carousel slide">
                <img src="~/screenshot1.png" class="d-block w-100" alt="Timed Run">
            </div>
        </div>
    </div>
</div>

<div class="b-example-divider"></div>

<div class="container my-5">
    <div class="row p-0 pb-0 pe-lg-0 pt-lg-0 align-items-center rounded-3 border shadow-lg">
        <div class="col-lg-5 offset-lg-0 d-flex align-items-center justify-content-center p-2 shadow-lg rounded-lg-3">
            <div id="carouselFull" class="carousel slide">
                <img src="~/screenshot1.png" class="d-block w-100" alt="Full Run">
            </div>
        </div>
        <div class="col-lg-7 p-3 p-lg-5 pt-lg-3">
            <h1 class="display-4 fw-bold lh-1 text-body-emphasis">
                0.7
            </h1>
            <p class="lead">
                0.7 was released on 19th April 2026. It was the first
                version to feature multiplayer functionality and the
                two gamemodes (Timed Run and Full Run). It also added
                all 50 levels and gimmicks associated with them, a lobby
                and a 4-player limit for matches, a UI overhaul and a
                restructured code for easier testing on multiple consoles.
            </p>
        </div>

    </div>
</div>
<div class="b-example-divider"></div>

<div class="container my-5">
    <div class="row p-3 pb-0 pe-lg-0 pt-lg-0 align-items-center rounded-3 border shadow-lg">
        <div class="col-lg-6 p-3 p-lg-5 pt-lg-3">
            <h1 class="display-4 fw-bold lh-1 text-body-emphasis">
                0.3
            </h1>
            <p class="lead">
                0.3 was the first version with sound, 10 more levels 
                and featured the first gimmick: pistons! It released 
                on Christmas. It was also a bit more stable than 0.2.1.
            </p>
        </div>
        <div class="col-lg-5 offset-lg-1 d-flex align-items-center justify-content-center p-2 shadow-lg rounded-lg-3">
            <div id="carouselTimed" class="carousel slide">
                <img src="~/screenshot1.png" class="d-block w-100" alt="Timed Run">
            </div>
        </div>
    </div>
</div>

<div class="b-example-divider"></div>

<div class="container my-5">
    <div class="row p-0 pb-0 pe-lg-0 pt-lg-0 align-items-center rounded-3 border shadow-lg">
        <div class="col-lg-5 offset-lg-0 d-flex align-items-center justify-content-center p-2 shadow-lg rounded-lg-3">
            <div id="carouselFull" class="carousel slide">
                <img src="~/screenshot1.png" class="d-block w-100" alt="Full Run">
            </div>
        </div>
        <div class="col-lg-7 p-3 p-lg-5 pt-lg-3">
            <h1 class="display-4 fw-bold lh-1 text-body-emphasis">
                0.2.1
            </h1>
            <p class="lead">
                The first public version of Duckmension VS. Released on
                25th October 2025. The physics were janky and there were
                only 5 levels but the core mechanic (switching dimensions)
                was finally there!
            </p>
        </div>

    </div>
</div>

<div class="b-example-divider"></div>