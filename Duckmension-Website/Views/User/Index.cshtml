@model Duckmension_Website.Models.UserProfile
@{
    ViewData["Title"] = "My profile";
}
<body>
    <h1 class="display-4 text-center">@ViewData["Title"]</h1>

    @if (TempData["msg"] != null)
    {
        <div class="alert alert-success">@TempData["msg"]</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />

        <div class="card">
            <div class="card-header">
                <ul class="nav nav-pills card-header-pills d-flex w-100">
                    <li class="nav-item">
                        <a class="nav-link bg-secondary flex-fill" href="#">Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link bg-secondary flex-fill" href="#">Settings</a>
                    </li>
                </ul>
            </div>
            <div class="card-body text-start">
                <div class="row">
                    <img src="duck.png" class="card-img-left rounded border border-secondary img-fluid col-md-4" width="256" height="256" alt="That's you!">
                    <div class="col-md-8">
                        <h3>@Model?.User?.UserName</h3>
                        <h5 class="card-text"><img src="cookie.png" />X </h5>
                        <h5 class="card-text">Hats owned x </h5>
                </div>
            </div>
        </div>
    </form>
</body>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
