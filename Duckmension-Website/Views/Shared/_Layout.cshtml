<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Duckmension_Website</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/Duckmension_Website.styles.css" asp-append-version="true" />
</head>
<style>
    .yellow-strip-container {
        /* shrink to fit the buttons instead of filling the whole page */
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .25rem;
        height: 64px;
        background: #ffc107 100%;
        border-radius: .5rem;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08) inset;
    }

    .yellow-strip-container .btn {
        background: transparent !important;
        border: none !important;
        color: #1a1a1a !important;
        height: 100%;
        padding: 0 1.25rem;
        border-radius: 0 !important;
        display: inline-flex;
        align-items: center;
    }
    .white-gradient {
        background-image: linear-gradient(to bottom, rgba(255,255,255,0.0) 0%, rgba(255,255,255,0.5) 50%, rgba(255,255,255,1) 100%);
        background-repeat: no-repeat;
        background-attachment: fixed;
        background-blend-mode: overlay;
    }
</style>
<body class="bg-info white-gradient ">
